# Variable NAMES only. Real values live in your secret manager / host settings.
ENVIRONMENT=development
# Migration/owner connection, used only by `python -m app.migrate`
DATABASE_URL=
# The API's least-privilege login (member of vetbuddy_app)
APP_DATABASE_URL=
# Optional: migrate creates/updates this login role
APP_DB_LOGIN=
APP_DB_PASSWORD=
# off | dev  (dev is refused in staging/production)
AUTH_MODE=off
# At least 32 characters; development only
AUTH_DEV_SECRET=
# e.g. http://localhost:5173
CORS_ORIGINS=
# Not used yet (no integration exists): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY, ANTHROPIC_API_KEY, VA_API_KEY
