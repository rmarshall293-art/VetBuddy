# Placeholders only. Never commit real values.
# API runtime — non-owner app role (RLS applies). NEVER the schema owner.
DATABASE_URL=host=localhost port=5432 user=vb_app password=REPLACE_ME dbname=vetbuddy_dev
# Migrations only — schema owner.
DATABASE_ADMIN_URL=host=localhost port=5432 user=postgres dbname=vetbuddy_dev
# "dev" = MOCK signed tokens for local work. Anything else = every protected route returns 401.
VB_AUTH_MODE=dev
VB_DEV_TOKEN_SECRET=REPLACE_ME_RANDOM_32_BYTES
# Managed-case privacy mode. Keep false until its security review passes.
VB_MODE_C_ENABLED=false
