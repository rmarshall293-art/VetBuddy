# =============================================================================
# VetBuddy Environment Variables
# =============================================================================
# Copy this file to `.env` for local development or Docker Compose.
# Never commit real secrets. Production values belong in your secrets manager.
# =============================================================================

# --- Application ---
APP_NAME=VetBuddy
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Security / JWT ---
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_DEV_ONLY_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (PostgreSQL) ---
POSTGRES_USER=vetbuddy
POSTGRES_PASSWORD=vetbuddy
POSTGRES_DB=vetbuddy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://vetbuddy:vetbuddy@localhost:5432/vetbuddy

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_PORT=6379

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# --- Backend port (Docker / local) ---
BACKEND_PORT=8000

# --- Stripe (test mode) ---
STRIPE_MOCK_MODE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CONSUMER=
STRIPE_PUBLISHABLE_KEY=
CONSUMER_PRICE_CENTS=599

# --- VA Lighthouse / FHIR sandbox ---
VA_MOCK_MODE=true
VA_CLIENT_ID=
VA_CLIENT_SECRET=
VA_REDIRECT_URI=http://localhost:8000/api/v1/va/lighthouse/callback
VA_API_BASE_URL=https://sandbox-api.va.gov

# --- OAuth placeholders ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Error tracking (optional) ---
SENTRY_DSN=

# --- Test overrides (pytest uses sqlite in-memory via pytest.ini) ---
# DATABASE_URL=sqlite+pysqlite:///:memory:
