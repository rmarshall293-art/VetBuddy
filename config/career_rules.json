  "protected_patterns": [
    [
      "social security number",
      "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      ""
    ],
    [
      "va disability rating",
      "\\b(?:\\d{1,3}\\s*%|\\d{1,3}\\s*percent)\\s*(?:VA\\s*)?(?:service[- ]connected|disab\\w*)",
      "i"
    ],
    [
      "va disability rating",
      "\\b(?:VA\\s+)?(?:service[- ]connected\\s+)?disab\\w*\\s*(?:rating\\s*)?(?:of\\s*)?\\d{1,3}\\s*%",
      "i"
    ],
    [
      "permanent and total rating",
      "\\b100\\s*%?\\s*(?:permanent\\s+and\\s+total|P&T)\\b",
      "i"
    ],
    [
      "full date of birth",
      "\\b(?:date of birth|DOB|born)\\b\\s*:?\\s*\\d",
      "i"
    ],
    [
      "marital status",
      "\\b(?:marital status|married|divorced|widowed)\\b",
      "i"
    ],
    [
      "medical diagnosis",
      "\\b(?:PTSD|TBI|diagnos\\w+|prescrib\\w+|therap(?:y|ist))\\b",
      "i"
    ],
    [
      "religion",
      "\\b(?:religion|religious affiliation)\\b",
      "i"
    ],
    [
      "race or ethnicity",
      "\\b(?:race|ethnicity)\\s*:",
      "i"
    ],
    [
      "salary target",
      "\\b(?:salary (?:target|requirements?|expectations?)|desired salary|target salary)\\b",
      "i"
    ]
  ],
