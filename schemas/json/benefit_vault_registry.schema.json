{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://vetbuddy.example/schemas/benefit_vault_registry.schema.json",
 "title": "VetBuddy Benefit Vault registry",
 "description": "The single runtime source for the Benefit Vault. Generated by scripts/build_vault_registry.py; never edited by hand.",
 "type": "object",
 "additionalProperties": false,
 "required": ["registry", "version", "as_of", "governing_sentence", "notice", "vocabulary", "facts", "jurisdictions",
              "sources", "benefits", "rule_leads", "recovered_leads", "license_reciprocity", "recovered_datasets",
              "governance", "caveats", "components", "tail_reads", "counts", "integrity"],
 "$defs": {
  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "https": {"type": "string", "pattern": "^https://[^\\s|]+$"},
  "jur": {"type": "string", "pattern": "^[A-Z]{2}$"},
  "text": {"type": "string", "minLength": 1, "maxLength": 600},
  "class": {"enum": ["V0", "V1", "V2", "V3", "V4", "V5"]},
  "record_status_unreviewed": {"enum": ["UNVERIFIED", "SOURCE_CHECKED", "CONTESTED", "SUPERSEDED", "ILLUSTRATIVE", "HEURISTIC"]},
  "build_status": {"enum": ["IMPLEMENTED_TESTED", "IMPLEMENTED_UNVERIFIED", "PARTIAL", "MOCK", "PLANNED", "DISABLED", "BLOCKED", "SOURCE_NOT_AVAILABLE"]},
  "category": {"enum": ["INCTAX", "PROPTAX", "PLATES", "GUARD_EDU", "EDU", "JOBS", "GUARD_PAY", "HUNTFISH", "PARKS", "HOMES", "BURIAL", "BONUS", "OTHER",
                         "SCHOLARSHIP", "PASS", "TICKETS", "DEALS", "TRAVEL", "MWR", "HEALTH", "HOUSING", "INSURANCE", "FAMILY", "LICENSE"]},
  "group": {"enum": ["ad", "ng", "rsv", "vet", "dv", "ret", "sp", "ch", "ss", "gs", "sm", "all"]},
  "agent": {
   "type": "object",
   "additionalProperties": false,
   "required": ["agent_id", "name", "plane", "role", "may_issue_determinations", "may_pull_from_agents", "highest_class_held", "exposes"],
   "properties": {
    "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,60}$"},
    "name": {"$ref": "#/$defs/text"},
    "plane": {"type": "integer", "minimum": 1, "maximum": 5},
    "role": {"$ref": "#/$defs/text"},
    "may_issue_determinations": {"const": false},
    "may_pull_from_agents": {"type": "boolean"},
    "highest_class_held": {"$ref": "#/$defs/class"},
    "exposes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_key", "data_class"],
      "properties": {
       "fact_key": {"type": "string", "pattern": "^[a-z][a-z_]{1,60}$"},
       "data_class": {"enum": ["V0", "V1", "V2"]}
      }
     }
    }
   },
   "if": {"properties": {"agent_id": {"not": {"const": "benefit_vault_agent"}}}},
   "then": {"properties": {"may_pull_from_agents": {"const": false}}},
   "else": {"properties": {"may_pull_from_agents": {"const": true}, "exposes": {"maxItems": 0}}}
  },
  "benefit": {
   "type": "object",
   "additionalProperties": false,
   "required": ["benefit_id", "jurisdiction", "category", "title", "groups", "rule", "rule_tokens", "who_it_is_for", "value",
                "official_url", "official_url_status", "official_url_tier", "kind", "source_id", "source_tier", "record_status",
                "page_part", "ledger_ref", "content_hash", "lead_ids", "caveat_ids"],
   "properties": {
    "benefit_id": {"type": "string", "pattern": "^[a-z]{2}\\.[a-z0-9-]{1,80}$"},
    "jurisdiction": {"$ref": "#/$defs/jur"},
    "category": {"$ref": "#/$defs/category"},
    "title": {"type": "string", "minLength": 1, "maxLength": 140},
    "groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/group"}},
    "rule": {"type": "string", "minLength": 1, "maxLength": 400, "pattern": "^[a-z0-9 &|!()<>=]+$"},
    "rule_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]+((>=|<)\\d+)?$"}},
    "who_it_is_for": {"type": "string", "minLength": 1, "maxLength": 280},
    "value": {"type": "string", "minLength": 1, "maxLength": 240},
    "official_url": {"$ref": "#/$defs/https"},
    "official_url_status": {"enum": ["SAME_AS_SOURCE", "LINKED_FROM_SOURCE", "SEEN_IN_SEARCH"]},
    "official_url_tier": {"enum": [1, 2, 3, 4]},
    "kind": {"enum": ["STATE_BENEFIT", "FEDERAL_BENEFIT", "NONPROFIT_PROGRAM", "COMMERCIAL_DEAL"]},
    "source_id": {"type": "string", "pattern": "^src\\.[a-z0-9.-]+$"},
    "source_tier": {"enum": [1, 2, 3, 4]},
    "record_status": {"$ref": "#/$defs/record_status_unreviewed"},
    "page_part": {"enum": ["main", "tail"]},
    "ledger_ref": {"type": "string", "pattern": "^(states|federal)/[A-Za-z0-9_.-]+\\.psv:\\d+$"},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "lead_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^gr\\.[a-z0-9_]+$"}},
    "caveat_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}
   },
   "allOf": [
    {"if": {"properties": {"jurisdiction": {"not": {"const": "US"}}}},
     "then": {"properties": {"kind": {"const": "STATE_BENEFIT"},
                              "category": {"enum": ["INCTAX", "PROPTAX", "PLATES", "GUARD_EDU", "EDU", "JOBS", "GUARD_PAY", "HUNTFISH", "PARKS", "HOMES", "BURIAL", "BONUS", "OTHER"]}}}},
    {"if": {"properties": {"official_url_status": {"const": "SEEN_IN_SEARCH"}}},
     "then": {"properties": {"record_status": {"const": "UNVERIFIED"}, "source_tier": {"const": 4}}}}
   ]
  }
 },
 "properties": {
  "registry": {"const": "vetbuddy.benefit_vault_registry"},
  "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
  "as_of": {"$ref": "#/$defs/date"},
  "governing_sentence": {"const": "Agents orchestrate, gather and explain; they never decide."},
  "notice": {"type": "string", "minLength": 1, "maxLength": 1200},
  "vocabulary": {
   "type": "object",
   "required": ["outcomes", "record_statuses", "build_statuses", "data_classes", "categories", "groups", "tokens", "token_facts"],
   "properties": {
    "outcomes": {"const": ["PRELIMINARY_MATCH", "NEEDS_INFORMATION", "NEEDS_EVIDENCE", "DOES_NOT_MEET_ENCODED_RULES", "SOURCE_STALE", "CONFLICTING_AUTHORITY", "HUMAN_REVIEW_REQUIRED"]},
    "record_statuses": {"const": ["UNVERIFIED", "SOURCE_CHECKED", "CONTESTED", "SUPERSEDED", "ILLUSTRATIVE", "HEURISTIC", "VERIFIED"]}
   }
  },
  "facts": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["data_class", "kind", "question", "values", "session_only", "pullable"],
    "properties": {
     "data_class": {"$ref": "#/$defs/class"},
     "kind": {"enum": ["enum", "bool", "int", "rating", "jurisdiction"]},
     "question": {"$ref": "#/$defs/text"},
     "values": {"type": "array", "items": {"type": "string"}},
     "session_only": {"type": "boolean"},
     "pullable": {"type": "boolean"}
    },
    "if": {"properties": {"data_class": {"enum": ["V3", "V4", "V5"]}}},
    "then": {"properties": {"pullable": {"const": false}}}
   }
  },
  "jurisdictions": {
   "type": "array",
   "minItems": 57,
   "maxItems": 57,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "name", "coverage", "benefit_count", "source_ids", "tail_read", "tail_unread_chars"],
    "properties": {
     "code": {"$ref": "#/$defs/jur"},
     "name": {"$ref": "#/$defs/text"},
     "coverage": {"enum": ["COVERED", "SOURCE_NOT_AVAILABLE"]},
     "benefit_count": {"type": "integer", "minimum": 0},
     "source_ids": {"type": "array", "items": {"type": "string"}},
     "tail_read": {"type": "boolean"},
     "tail_unread_chars": {"type": "integer", "minimum": 0}
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "url", "page_status", "tier", "opened_on", "seen_on", "page_updated", "tail_unread_chars", "parts_read", "ledgers"],
    "properties": {
     "source_id": {"type": "string", "pattern": "^src\\.[a-z0-9.-]+$"},
     "url": {"oneOf": [{"$ref": "#/$defs/https"}, {"type": "null"}]},
     "page_status": {"enum": ["OPENED", "SEEN_IN_SEARCH"]},
     "tier": {"enum": [1, 2, 3, 4]},
     "opened_on": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
     "seen_on": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
     "page_updated": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
     "tail_unread_chars": {"type": "integer", "minimum": 0},
     "parts_read": {"type": "array", "items": {"enum": ["main", "tail"]}},
     "ledgers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
   }
  },
  "benefits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/benefit"}},
  "rule_leads": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["lead_id", "topic", "citation", "lead", "caveat", "correction_on_record", "record_status", "source"],
    "properties": {
     "lead_id": {"type": "string", "pattern": "^gr\\.[a-z0-9_]+$"},
     "topic": {"$ref": "#/$defs/text"},
     "citation": {"$ref": "#/$defs/text"},
     "lead": {"$ref": "#/$defs/text"},
     "caveat": {"type": ["string", "null"]},
     "correction_on_record": {"type": ["string", "null"]},
     "record_status": {"$ref": "#/$defs/record_status_unreviewed"},
     "source": {"type": "object"}
    }
   }
  },
  "recovered_leads": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["lead_id", "title", "organization", "jurisdiction", "claim", "url", "record_status", "tier", "dataset", "recovered_from", "cross_check"],
    "properties": {
     "lead_id": {"type": "string", "pattern": "^(RB|RS)\\d{2}$"},
     "title": {"$ref": "#/$defs/text"},
     "organization": {"$ref": "#/$defs/text"},
     "jurisdiction": {"$ref": "#/$defs/jur"},
     "claim": {"$ref": "#/$defs/text"},
     "url": {"oneOf": [{"$ref": "#/$defs/https"}, {"type": "null"}]},
     "record_status": {"enum": ["UNVERIFIED", "ILLUSTRATIVE"]},
     "tier": {"const": 4},
     "dataset": {"type": "string"},
     "recovered_from": {"$ref": "#/$defs/https"},
     "cross_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benefit_id", "relation", "note"],
      "properties": {
       "benefit_id": {"type": ["string", "null"]},
       "relation": {"enum": ["agrees", "differs", "none"]},
       "note": {"type": ["string", "null"]}
      }
     }
    }
   }
  },
  "license_reciprocity": {
   "type": "object",
   "required": ["record_status", "tier", "note", "recovered_from", "states"],
   "properties": {
    "record_status": {"const": "UNVERIFIED"},
    "tier": {"const": 4},
    "states": {
     "type": "object",
     "propertyNames": {"pattern": "^[A-Z]{2}$"},
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher_full_reciprocity", "lawyer_ube", "real_estate"],
      "properties": {
       "teacher_full_reciprocity": {"type": "boolean"},
       "lawyer_ube": {"type": "boolean"},
       "real_estate": {"enum": ["full", "partial", "none"]}
      }
     }
    }
   }
  },
  "recovered_datasets": {"type": "array", "items": {"type": "object", "required": ["path", "location", "tier", "sha256", "vault_use"]}},
  "governance": {
   "type": "object",
   "additionalProperties": false,
   "required": ["publish_policy", "review", "grants", "packets", "mode_ceiling", "never_pullable", "pull_purposes", "agents",
                "egress_allowlist", "discovery", "tier_hosts"],
   "properties": {
    "publish_policy": {
     "type": "object",
     "required": ["environments", "default_environment"],
     "properties": {
      "environments": {
       "type": "object",
       "required": ["production"],
       "properties": {"production": {"const": "verified_only"}},
       "additionalProperties": {"enum": ["verified_only", "preview_unverified"]}
      },
      "default_environment": {"const": "production"}
     }
    },
    "review": {"type": "object", "required": ["stale_after_days"], "properties": {"stale_after_days": {"type": "integer", "minimum": 30, "maximum": 730}}},
    "grants": {
     "type": "object",
     "required": ["default_days", "max_days", "session_max_hours"],
     "properties": {
      "default_days": {"type": "integer", "minimum": 1, "maximum": 90},
      "max_days": {"type": "integer", "minimum": 1, "maximum": 90},
      "session_max_hours": {"type": "integer", "minimum": 1, "maximum": 24}
     }
    },
    "packets": {"type": "object", "required": ["ttl_seconds"], "properties": {"ttl_seconds": {"type": "integer", "minimum": 30, "maximum": 900}}},
    "mode_ceiling": {"const": {"A": "V1", "B": "V2"}},
    "never_pullable": {"const": ["V3", "V4", "V5"]},
    "pull_purposes": {"const": ["benefit_matching"]},
    "agents": {
     "type": "array",
     "minItems": 1,
     "items": {"$ref": "#/$defs/agent"},
     "contains": {"properties": {"agent_id": {"const": "benefit_vault_agent"}}},
     "minContains": 1,
     "maxContains": 1
    },
    "egress_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
    "discovery": {"type": "object", "required": ["templates", "search_endpoints"]},
    "tier_hosts": {"type": "object"}
   }
  },
  "caveats": {"type": "object", "additionalProperties": {"$ref": "#/$defs/text"}},
  "components": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "name", "status"],
    "properties": {"id": {"type": "string", "pattern": "^V\\d{2}$"}, "name": {"$ref": "#/$defs/text"},
                   "status": {"$ref": "#/$defs/build_status"}, "note": {"type": "string"}}
   }
  },
  "tail_reads": {"type": "array"},
  "counts": {
   "type": "object",
   "required": ["benefits", "sources", "verified"],
   "properties": {"verified": {"const": 0}}
  },
  "integrity": {
   "type": "object",
   "additionalProperties": false,
   "required": ["algorithm", "canonical", "sha256"],
   "properties": {"algorithm": {"const": "sha256"}, "canonical": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
  }
 }
}
